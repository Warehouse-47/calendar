---
import Layout from '../../layouts/Layout.astro';
import collaborationData from '../../data/collaboration.generated.json';

// Fetch the compiled playbook entries from the generated JSON
const playbookEntries = collaborationData.Playbook || [];
---

<Layout title="Execution Playbook" description="Declassified best practices and case studies for Warehouse47 activations.">
  <header class="p-8 border-b brutalist-border flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <a href="/" class="mono text-xs opacity-60 hover:opacity-100">[ &lt;- BACK_TO_MANIFEST ]</a>
    <div class="text-left md:text-right mono text-[10px] opacity-50 tracking-[0.2em] uppercase">
      [ BEST_PRACTICE_DECK ]<br />
      [ SOURCE: SHEET-BACKED ]
    </div>
  </header>

  <section class="border-b brutalist-border px-8 py-12 uppercase text-center">
    <p class="mono text-xs opacity-60 mb-3 tracking-[0.18em]">[ Intelligence Desk ]</p>
    <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-none">Best Practices</h1>
    <p class="mono text-xs mt-4 opacity-70 max-w-3xl mx-auto leading-relaxed">
      // Distilled learning from on-ground execution. Open the playbook for tactical frameworks, formats, and post-action reports.
    </p>
  </section>

  <section class="p-8 min-h-screen bg-white/5 border-b brutalist-border">
    <div class="flex flex-wrap justify-center gap-6 max-w-7xl mx-auto">
      {playbookEntries.map((entry) => (
        <article class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] border brutalist-border bg-[#050505] p-6 flex flex-col hover:bg-white/5 transition-colors">
          <div class="flex justify-between items-start mb-6 border-b brutalist-border/30 pb-4">
            <p class="mono text-[10px] uppercase opacity-55 tracking-widest">
              [ {entry.status || 'LIVE'} ]
            </p>
            <div class="text-right">
              <p class="text-3xl font-black leading-none">{String(entry.executionCount || '0').padStart(2, '0')}</p>
              <p class="mono text-[8px] uppercase opacity-50 mt-1 tracking-widest">Executions</p>
            </div>
          </div>
          
          <div class="flex-grow">
            <h2 class="text-2xl font-black tracking-tight uppercase mb-3">{entry.title}</h2>
            <p class="mono text-xs uppercase opacity-70 leading-relaxed">
              {entry.summary || 'Context pending.'}
            </p>
          </div>

          <div class="mt-8 pt-4">
            {entry.primaryLink ? (
              <a
                href={entry.primaryLink}
                target="_blank"
                rel="noreferrer"
                class="w-full inline-flex items-center justify-center border brutalist-border px-5 py-3 mono text-xs uppercase hover:bg-white hover:text-black transition-colors"
              >
                Open Playbook
              </a>
            ) : (
              <button
                disabled
                class="w-full inline-flex items-center justify-center border border-dashed border-white/30 px-5 py-3 mono text-xs uppercase opacity-50 cursor-not-allowed"
              >
                Compiling...
              </button>
            )}
          </div>
        </article>
      ))}

      {playbookEntries.length === 0 && (
        <div class="w-full p-16 text-center mono uppercase text-sm opacity-40 tracking-widest border border-dashed border-white/20">
          [ NO_PLAYBOOKS_DECRYPTED_YET ]
        </div>
      )}
    </div>
  </section>

  <section class="px-8 py-10">
    <div class="max-w-6xl mx-auto border brutalist-border p-6 md:p-8">
      <div class="mb-7 uppercase text-center max-w-3xl mx-auto">
        <p class="mono text-[10px] opacity-55 tracking-[0.2em]">[ Activation Philosophy ]</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter mt-2">In-Store Activation Philosophy</h2>
        <p class="mono text-xs opacity-70 mt-3 leading-relaxed">
          Every store plan must align with the category's point of view, fitment, customer motion, and the business outcome it is meant to unlock.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">01</p>
          <h3 class="text-lg font-black uppercase mt-2">Story First</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Lead with the category's emotion and the specific retail behavior it needs to trigger.
          </p>
        </article>
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">02</p>
          <h3 class="text-lg font-black uppercase mt-2">Context Fitment</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Adapt formats to the store type, audience profile, and existing momentum in the room.
          </p>
        </article>
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">03</p>
          <h3 class="text-lg font-black uppercase mt-2">Recall</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Design moments that are instantly memorable, highly shareable, and talk-worthy.
          </p>
        </article>
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">04</p>
          <h3 class="text-lg font-black uppercase mt-2">Native Integration</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Blend seamlessly with merchandise flow, staff coordination, and daily operational rhythm.
          </p>
        </article>
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">05</p>
          <h3 class="text-lg font-black uppercase mt-2">Conversion</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Drive measurable store visits, longer dwell times, and healthier sales momentum.
          </p>
        </article>
        <article class="border brutalist-border p-5">
          <p class="mono text-[10px] uppercase opacity-55">06</p>
          <h3 class="text-lg font-black uppercase mt-2">Scale Learnings</h3>
          <p class="mono text-[10px] uppercase opacity-70 mt-2 leading-relaxed">
            Capture and document wins so the next execution repeats the best parts with less friction.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>