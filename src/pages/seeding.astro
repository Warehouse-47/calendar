---
import Layout from '../layouts/Layout.astro';
import { buildCollectionPageStructuredData } from '../lib/seo';

const interestWebhookUrl = String(import.meta.env.PUBLIC_INTEREST_APPS_SCRIPT_URL ?? '').trim();
const barcodeDeckUrl = String(import.meta.env.PUBLIC_BARCODE_DECK_URL ?? '').trim();
const barcodeWebsiteUrl = String(import.meta.env.PUBLIC_BARCODE_WEBSITE_URL ?? '').trim();
const rareClubDeckUrl = String(
  import.meta.env.PUBLIC_RARE_CLUB_DECK_URL ?? '',
).trim();
const rareClubWebsiteUrl = String(import.meta.env.PUBLIC_RARE_CLUB_WEBSITE_URL ?? '').trim();
const brandCollaborationUrl = '/collaboration/brands';
const artistCollaborationUrl = '/collaboration/artists';
const influencerCollaborationUrl = '/collaboration/influencers';

const pageStructuredData = [
  buildCollectionPageStructuredData({
    path: '/seeding',
    name: 'Warehouse47 Seeding Desk',
    description:
      'Share your seeding, creator collaboration, and amplification brief. Warehouse47 routes the mandate through partner distribution teams.',
  }),
];
---

<Layout
  title="Seeding Desk"
  description="Submit seeding, creator collaboration, and amplification briefs to the Warehouse47 partner network."
  structuredData={pageStructuredData}
>
  <header class="p-8 border-b brutalist-border flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <a href="/" class="mono text-xs opacity-60 hover:opacity-100">[ &lt;- BACK_TO_MANIFEST ]</a>
    <div class="text-left md:text-right mono text-[10px] opacity-50 tracking-[0.2em] uppercase">
      [ SEEDING_DESK ]<br />
      [ STATUS: OPEN ]
    </div>
  </header>

  <section class="border-b brutalist-border px-8 py-12 uppercase text-center">
    <p class="mono text-xs opacity-60 mb-3 tracking-[0.18em]">Partner-Led Distribution Desk</p>
    <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-none">Seeding</h1>
    <p class="mono text-xs mt-4 opacity-70 max-w-3xl mx-auto leading-relaxed">
      // Launch stronger with calibrated seeding, sharper amplification, and creator collaboration through trusted partner networks.
      Share your brief once, and we route it to the team that best matches your mandate.
    </p>
  </section>

  <section class="border-b brutalist-border px-8 py-8">
    <div class="flex flex-wrap justify-center gap-4 max-w-6xl mx-auto">
      <!-- NEW: Influencer Card -->
      <article class="w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)] border brutalist-border p-6 text-center flex flex-col">
        <div class="flex-grow">
          <p class="mono text-[10px] uppercase opacity-55">Specialization</p>
          <h2 class="text-3xl font-black tracking-tight uppercase mt-2">Influencer Desk</h2>
          <p class="mono text-xs uppercase opacity-70 mt-3">Sourcing & Outreach</p>
          <p class="mono text-[10px] uppercase opacity-55 mt-4 leading-relaxed max-w-sm mx-auto">
            Direct access to vetted creator networks. Optimized for niche targeting, a-list amplification, and genuine brand alignment.
          </p>
        </div>
        <div class="partner-link-row mt-5">
          <a href={influencerCollaborationUrl} class="inline-flex items-center justify-center border brutalist-border px-5 py-2.5 mono text-xs uppercase hover:bg-white hover:text-black">
            Influence Brief 
          </a>
        </div>
      </article>

      <article class="w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)] border brutalist-border p-6 text-center flex flex-col">
        <div class="flex-grow">
          <p class="mono text-[10px] uppercase opacity-55">Partner</p>
          <h2 class="text-3xl font-black tracking-tight uppercase mt-2">Rare Club</h2>
          <p class="mono text-xs uppercase opacity-70 mt-3">Seeding and amplification support</p>
          <p class="mono text-[10px] uppercase opacity-55 mt-4 leading-relaxed max-w-sm mx-auto">
            Long-term creator and influencer partnership profiles for brands that want a repeatable collaboration system.
          </p>
        </div>
        {rareClubDeckUrl || rareClubWebsiteUrl ? (
          <div class="partner-link-row mt-5">
            {rareClubDeckUrl && (
              <a href={rareClubDeckUrl} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center border brutalist-border px-5 py-2.5 mono text-xs uppercase hover:bg-white hover:text-black">
                Open Collaboration Deck
              </a>
            )}
            {rareClubWebsiteUrl && (
              <a href={rareClubWebsiteUrl} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center border brutalist-border px-5 py-2.5 mono text-xs uppercase hover:bg-white hover:text-black">
                Open Website
              </a>
            )}
          </div>
        ) : (
          <p class="mono text-xs uppercase opacity-50 mt-5">Links not set yet.</p>
        )}
      </article>

      <article class="w-full md:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)] border brutalist-border p-6 text-center flex flex-col">
        <div class="flex-grow">
          <p class="mono text-[10px] uppercase opacity-55">Partner</p>
          <h2 class="text-3xl font-black tracking-tight uppercase mt-2">Strategic Collaboration</h2>
          <p class="mono text-xs uppercase opacity-70 mt-3">Dedicated collaboration pages for brand and artist-led briefs</p>
          <p class="mono text-[10px] uppercase opacity-55 mt-4 leading-relaxed max-w-sm mx-auto">
            Live sheet-backed pages for structured, long-term brand and artist collaboration briefs.
          </p>
        </div>
        <div class="partner-link-row mt-5">
          <a href={brandCollaborationUrl} class="inline-flex items-center justify-center border brutalist-border px-5 py-2.5 mono text-xs uppercase hover:bg-white hover:text-black">
            Brand Collaboration
          </a>
          <a href={artistCollaborationUrl} class="inline-flex items-center justify-center border brutalist-border px-5 py-2.5 mono text-xs uppercase hover:bg-white hover:text-black">
            Artist
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="px-8 py-10">
    <div class="max-w-4xl border brutalist-border p-6 md:p-8 mx-auto">
      <div class="mb-8 uppercase text-center max-w-3xl mx-auto">
        <p class="mono text-[10px] opacity-55 tracking-[0.2em]">[ Brief Intake ]</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter mt-2">Share Your Brief</h2>
        <p class="mono text-xs opacity-70 mt-3 leading-relaxed">
          Give us your campaign context, timeline, and contact details. Fields marked with * are required.
        </p>
        <p class="mono text-[11px] uppercase mt-4 mb-2 min-h-[1.5rem]" id="seeding-form-status" role="status" aria-live="polite"></p>
      </div>

      <div class="flex justify-center items-center gap-2 md:gap-6 mb-8 mono text-[10px] uppercase tracking-wider" id="form-progress">
        <span class="step-indicator active" data-step-id="0">[ 1. Brand ]</span>
        <span class="opacity-30">/</span>
        <span class="step-indicator opacity-40" data-step-id="1">[ 2. Needs ]</span>
        <span class="opacity-30">/</span>
        <span class="step-indicator opacity-40" data-step-id="2">[ 3. Logistics ]</span>
      </div>

      <form id="seeding-form" data-submit-endpoint={interestWebhookUrl}>
        <input type="hidden" name="interestType" value="seeding" />

        {/* STEP 1: BRAND DETAILS */}
        <div class="form-step" data-step="0" style="display: block;">
          <div class="seeding-form-grid">
            <label>
              Brief Type *
              <select name="briefType" required>
                <option value="General">General Seeding</option>
                <option value="Influencer">Influencer/Creator Specific</option>
                <option value="Strategic">Strategic Partnership</option>
              </select>
            </label>

            <label>
              Brand Type *
              <select name="seedingBrandType" required>
                <option value="">Select brand type</option>
                <option value="D2C">D2C</option>
                <option value="F&B">F&B</option>
                <option value="Fashion / Beauty">Fashion / Beauty</option>
                <option value="Beverage">Beverage</option>
                <option value="Consumer Tech">Consumer Tech</option>
                <option value="Media / Entertainment">Media / Entertainment</option>
                <option value="B2B / Services">B2B / Services</option>
                <option value="Other">Other</option>
              </select>
            </label>

            <label>
              Brand Name *
              <input type="text" name="seedingBrandName" required />
            </label>

            <label>
              POC Name *
              <input type="text" name="seedingPocName" autocomplete="name" required />
            </label>

            <div class="seeding-form-grid__full grid grid-cols-1 md:grid-cols-2 gap-4">
              <label>
                POC Email
                <input type="email" name="seedingPocEmail" autocomplete="email" />
              </label>

              <label>
                POC Phone
                <input type="tel" name="seedingPocPhone" autocomplete="tel" />
              </label>
            </div>
          </div>
          <div class="flex justify-end border-top-divider mt-6 pt-6">
            <button type="button" class="btn-next border brutalist-border px-6 py-3 mono text-xs uppercase hover:bg-white hover:text-black">
              Next Stage -&gt;
            </button>
          </div>
        </div>

        {/* STEP 2: CAMPAIGN CONTEXT */}
        <div class="form-step" data-step="1" style="display: none;">
          <div class="seeding-form-grid">
            <label class="seeding-form-grid__full">
              Preferred Partner
              <select name="seedingPartnerPreference">
                <option value="">No preference</option>
                <option value="Barcode">Barcode</option>
                <option value="Rare Club">Rare Club</option>
                <option value="Strategic Collaboration">Strategic Collaboration</option>
                <option value="Open To Recommendation">Open To Recommendation</option>
              </select>
            </label>

            <label class="seeding-form-grid__full">
              Service Requirement *
              <div class="seeding-checkbox-grid" role="group" aria-label="Service requirement">
                <label><input type="checkbox" name="seedingServiceNeed" value="Seeding" /> Seeding</label>
                <label><input type="checkbox" name="seedingServiceNeed" value="Amplification" /> Amplification</label>
                <label><input type="checkbox" name="seedingServiceNeed" value="Creator Collaboration" /> Creator Collaboration</label>
                <label><input type="checkbox" name="seedingServiceNeed" value="Influencer Marketing" /> Influencer Marketing</label>
              </div>
            </label>

            <label class="seeding-form-grid__full">
              Influencer Niche / Target Profile
              <input type="text" name="seedingInfluencerNiche" placeholder="e.g. Luxury Lifestyle, Tech-Reviewers, Vegan Culinary" />
            </label>

            <label class="seeding-form-grid__full">
              Event / Campaign Context *
              <textarea
                name="seedingEventContext"
                rows="4"
                required
                placeholder="Tell us about the event, launch, campaign objective, and target audience."
              ></textarea>
            </label>
          </div>
          <div class="flex justify-between border-top-divider mt-6 pt-6">
            <button type="button" class="btn-prev border border-dashed border-white/30 px-6 py-3 mono text-xs uppercase hover:bg-white/10">
              &lt;- Back
            </button>
            <button type="button" class="btn-next border brutalist-border px-6 py-3 mono text-xs uppercase hover:bg-white hover:text-black">
              Next Stage -&gt;
            </button>
          </div>
        </div>

        {/* STEP 3: LOGISTICS & SUBMIT */}
        <div class="form-step" data-step="2" style="display: none;">
          <div class="seeding-form-grid">
            <label>
              Tentative Dates *
              <input type="text" name="seedingTentativeDates" required placeholder="Example: 10-20 May 2026" />
            </label>

            <label>
              Market / City Focus
              <input type="text" name="seedingMarket" placeholder="Example: Mumbai, Delhi NCR" />
            </label>

            <label class="seeding-form-grid__full">
              Additional Notes
              <textarea name="seedingNotes" rows="3"></textarea>
            </label>
          </div>
          <div class="flex flex-col md:flex-row justify-between items-center gap-4 border-top-divider mt-6 pt-6">
            <button type="button" class="btn-prev border border-dashed border-white/30 px-6 py-3 mono text-xs uppercase w-full md:w-auto hover:bg-white/10">
              &lt;- Back
            </button>
            <button type="submit" id="seeding-submit" class="border brutalist-border px-8 py-3 mono text-xs uppercase w-full md:w-auto hover:bg-white hover:text-black font-bold">
              Submit Brief
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('seeding-form') as HTMLFormElement | null;
    const submit = document.getElementById('seeding-submit') as HTMLButtonElement | null;
    const status = document.getElementById('seeding-form-status') as HTMLParagraphElement | null;

    if (!form || !submit || !status) return;

    const steps = Array.from(form.querySelectorAll('.form-step')) as HTMLElement[];
    const indicators = Array.from(document.querySelectorAll('.step-indicator')) as HTMLElement[];
    let currentStepIndex = 0;

    function updateStepUI() {
      steps.forEach((step, index) => {
        step.style.display = index === currentStepIndex ? 'block' : 'none';
      });
      indicators.forEach((ind, index) => {
        if (index === currentStepIndex) {
          ind.classList.remove('opacity-40');
          ind.classList.add('active');
          ind.style.fontWeight = 'bold';
        } else {
          ind.classList.add('opacity-40');
          ind.classList.remove('active');
          ind.style.fontWeight = 'normal';
        }
      });
      status.textContent = '';
      status.classList.remove('seeding-status-error');
    }

    function validateCurrentStep(): boolean {
      const step = steps[currentStepIndex];
      const inputs = Array.from(step.querySelectorAll('input, select, textarea')) as HTMLInputElement[];
      const firstInvalid = inputs.find(input => !input.checkValidity());
      if (firstInvalid) {
        firstInvalid.reportValidity();
        return false;
      }
      if (currentStepIndex === 0) {
        const email = (form.querySelector('[name="seedingPocEmail"]') as HTMLInputElement).value.trim();
        const phone = (form.querySelector('[name="seedingPocPhone"]') as HTMLInputElement).value.trim();
        if (!email && !phone) {
          status.textContent = '[ ERROR: Add at least one contact detail - email or phone. ]';
          status.classList.add('seeding-status-error');
          return false;
        }
      }
      if (currentStepIndex === 1) {
        const checkedNeeds = step.querySelectorAll('input[name="seedingServiceNeed"]:checked');
        if (checkedNeeds.length === 0) {
          status.textContent = '[ ERROR: Select at least one service requirement. ]';
          status.classList.add('seeding-status-error');
          return false;
        }
      }
      return true;
    }

    form.querySelectorAll('.btn-next').forEach(btn => {
      btn.addEventListener('click', () => {
        if (validateCurrentStep()) {
          currentStepIndex++;
          updateStepUI();
        }
      });
    });

    form.querySelectorAll('.btn-prev').forEach(btn => {
      btn.addEventListener('click', () => {
        currentStepIndex--;
        updateStepUI();
      });
    });

    const endpoint = String(form.dataset.submitEndpoint || '').trim();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateCurrentStep()) return;
      if (!endpoint) {
        status.textContent = '[ ERROR: Submission endpoint is not configured. ]';
        status.classList.add('seeding-status-error');
        return;
      }

      const selectedNeeds = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="seedingServiceNeed"]:checked'),
      ).map((input) => input.value.trim()).filter(Boolean);

      const formData = new FormData(form);
      const payload = {
        interestType: 'seeding',
        briefType: String(formData.get('briefType') || '').trim(),
        seedingBrandType: String(formData.get('seedingBrandType') || '').trim(),
        seedingBrandName: String(formData.get('seedingBrandName') || '').trim(),
        seedingPocName: String(formData.get('seedingPocName') || '').trim(),
        seedingPocEmail: String(formData.get('seedingPocEmail') || '').trim(),
        seedingPocPhone: String(formData.get('seedingPocPhone') || '').trim(),
        seedingServiceNeeds: selectedNeeds.join(', '),
        seedingPartnerPreference: String(formData.get('seedingPartnerPreference') || '').trim(),
        seedingInfluencerNiche: String(formData.get('seedingInfluencerNiche') || '').trim(),
        seedingEventContext: String(formData.get('seedingEventContext') || '').trim(),
        seedingTentativeDates: String(formData.get('seedingTentativeDates') || '').trim(),
        seedingMarket: String(formData.get('seedingMarket') || '').trim(),
        seedingNotes: String(formData.get('seedingNotes') || '').trim(),
      };

      submit.disabled = true;
      submit.textContent = 'Transmitting...';
      status.textContent = '[ STATUS: Transmitting brief to server... ]';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);

        status.textContent = '[ SUCCESS: Brief submitted. Team will reach out shortly. ]';
        form.reset();
        currentStepIndex = 0;
        updateStepUI();
      } catch (error) {
        status.textContent = `[ ERROR: ${error instanceof Error ? error.message : 'Submission failed.'} ]`;
        status.classList.add('seeding-status-error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Submit Brief';
      }
    });
  });
</script>

<style>
  .seeding-form-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (min-width: 840px) {
    .seeding-form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
    }
  }

  .seeding-form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--font-mono, 'Space Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .seeding-form-grid input,
  .seeding-form-grid textarea,
  .seeding-form-grid select {
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #050505;
    color: #fff;
    padding: 0.7rem 0.75rem;
    border-radius: 0;
    outline: none;
    font-family: inherit;
    font-size: 0.78rem;
    text-transform: none;
  }

  .seeding-form-grid input:focus,
  .seeding-form-grid textarea:focus,
  .seeding-form-grid select:focus {
    border-color: rgba(255, 255, 255, 0.65);
  }

  .seeding-form-grid__full {
    grid-column: 1 / -1;
  }

  .seeding-checkbox-grid {
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.65rem;
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (min-width: 840px) {
    .seeding-checkbox-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .seeding-checkbox-grid label {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .seeding-checkbox-grid input[type='checkbox'] {
    width: 0.95rem;
    height: 0.95rem;
    margin: 0;
    padding: 0;
    accent-color: #fff;
  }

  .border-top-divider {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .seeding-status-error {
    color: #ff8f8f;
  }

  .partner-link-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  #seeding-submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>